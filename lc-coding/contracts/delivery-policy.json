{
  "version": "2.7.0",
  "per_delivery_confirmation_required": true,
  "defaults_are_recommendations": true,
  "recommended_runtime": "Ubuntu",
  "docker_required": false,
  "recommended_source_code_included": false,
  "owner_locked_default_exclusions": [
    "LCagent",
    "LCapi",
    "LCCoding",
    "Calabash",
    "SLK",
    "CLK",
    "GLK",
    "Project Intelligence",
    "Canonical Assets",
    "Development Evidence"
  ],
  "prohibited_rights": [
    "resale",
    "redistribution",
    "sublicense",
    "repackaging",
    "unauthorized_modification",
    "reverse_engineering",
    "transfer",
    "control_removal"
  ],
  "required_decision_groups": [
    "delivery_model",
    "assets",
    "source_and_modification_rights",
    "runtime_and_infrastructure",
    "data",
    "internal_dependencies",
    "license",
    "operations"
  ],
  "delivery_decision_candidate_identity": "ID / sha256:<64 lowercase hex>",
  "delivery_manifest_candidate_identity": "ID / sha256:<64 lowercase hex>",
  "json_contract": "strict UTF-8 JSON; duplicate keys, NaN, Infinity, -Infinity, trailing data, malformed bytes rejected",
  "meaningful_delivery_value_contract": "one shared safe syntax and closed generic/status/test vocabulary for Decision, Manifest and verification receipt identities/text; identity first token cannot be a generic/status/test value",
  "decision_answer_contract": "each required group is exactly {selected: non-placeholder customer answer}",
  "agent_delivery_decision_records": {
    "runtime_and_infrastructure": "AGENT_DELIVERY_V1;runtime_responsibility=CUSTOMER;model_responsibility=CUSTOMER;provider_responsibility=CUSTOMER;replacement_route=IMPACT_SECURITY_REVALIDATION",
    "data": "AGENT_DELIVERY_V1;credential_owner=CUSTOMER;private_agent_data=EXCLUDED",
    "operations": "AGENT_DELIVERY_V1;fallback_operation=OWNER_CONTROLLED;kill_switch_operation=OWNER_CONTROLLED;audit_retention=APPEND_ONLY_RETAINED"
  },
  "agent_delivery_certification_fields": [
    "state", "candidate_id", "candidate_hash", "configuration_baseline_id",
    "configuration_baseline_hash", "production_topology_id", "production_topology_hash",
    "runtime_adapter_attestation_id", "runtime_adapter_attestation_hash",
    "runtime_adapter_id", "runtime_adapter_version", "runtime_adapter_digest",
    "product_agent_applicability", "product_agent_id", "operations_agent_id",
    "operations_base_model_id", "operations_base_model_hash",
    "operations_runtime_provider_id", "operations_runtime_provider_hash",
    "product_base_model_id", "product_base_model_hash",
    "product_runtime_provider_id", "product_runtime_provider_hash",
    "isolation_evidence_id", "isolation_evidence_hash",
    "fallback_evidence_id", "fallback_evidence_hash",
    "kill_switch_evidence_id", "kill_switch_evidence_hash",
    "audit_evidence_id", "audit_evidence_hash",
    "vulnerability_closure_id", "vulnerability_closure_hash",
    "post_security_acceptance_id", "post_security_acceptance_hash",
    "result"
  ],
  "agent_delivery_manifest_fields": [
    "state", "candidate_id", "candidate_hash", "configuration_baseline_id",
    "configuration_baseline_hash", "production_topology_id", "production_topology_hash",
    "runtime_adapter_attestation_id", "runtime_adapter_attestation_hash",
    "runtime_adapter_id", "runtime_adapter_version", "runtime_adapter_digest",
    "product_agent_applicability", "product_agent_id", "operations_agent_id",
    "operations_base_model_id", "operations_base_model_hash",
    "operations_runtime_provider_id", "operations_runtime_provider_hash",
    "product_base_model_id", "product_base_model_hash",
    "product_runtime_provider_id", "product_runtime_provider_hash",
    "isolation_evidence_id", "isolation_evidence_hash",
    "fallback_evidence_id", "fallback_evidence_hash",
    "kill_switch_evidence_id", "kill_switch_evidence_hash",
    "audit_evidence_id", "audit_evidence_hash",
    "vulnerability_closure_id", "vulnerability_closure_hash",
    "post_security_acceptance_id", "post_security_acceptance_hash",
    "runtime_certification_reference", "runtime_certification_hash",
    "delivery_decision_id", "delivery_decision_hash", "approved_product_assets",
    "approved_runtime_assets", "result"
  ],
  "agent_delivery_forbidden_asset_terms": [
    "raw-prompt", "raw-prompts", "system-prompt", "system-prompts",
    "private-memory", "private-memories", "session", "sessions",
    "context", "contexts", "retriever", "retrievers",
    "vector-store", "vector-stores", "prompt-cache", "prompt-caches",
    "credential", "credentials", "secret", "secrets", "key", "keys",
    "construction-agent", "construction-agents",
    "runtime-internal", "runtime-internals"
  ],
  "delivery_qa_status_join": "decision COMPLETE requires status.delivery_method_qa=DELIVERY_METHOD_CONFIRMED for the exact current candidate",
  "decision_locked_exclusions_contract": "exact ordered equality with owner_locked_default_exclusions",
  "protected_asset_match": "case-insensitive path-segment and packaged-basename match across slash styles; repeatedly peel the one finite archive/package/library suffix table longest-first to a fixed point, checking every layer against canonical basename plus semantic-version/build suffix grammar",
  "protected_package_suffixes": [
    ".tar.gz",
    ".nupkg",
    ".appx",
    ".msix",
    ".dylib",
    ".wasm",
    ".whl",
    ".deb",
    ".rpm",
    ".pkg",
    ".dmg",
    ".lib",
    ".dll",
    ".pdb",
    ".jar",
    ".zip",
    ".tar",
    ".tgz",
    ".gz",
    ".7z",
    ".exe",
    ".msi",
    ".so",
    ".a"
  ],
  "delivery_metadata_contract": "meaningful non-generic IDs, existing three-part version format, and exact valid UTC confirmation timestamp",
  "required_current_security_relationship": [
    "status.canonical_candidate",
    "status.vulnerability_closure=VULNERABILITY_CLOSED",
    "status.post_security_owner_acceptance=POST_SECURITY_OWNER_ACCEPTED",
    "status.phase_gates.DELIVERY_READY=DELIVERY_READY"
  ],
  "required_delivery_joins": [
    "manifest.candidate_id=decision.candidate_id=status.canonical_candidate",
    "manifest.delivery_decision_id=decision.delivery_decision_id",
    "manifest.delivery_id=decision.delivery_id"
  ],
  "package_hashes_contract": {
    "shape": "non-empty closed asset-path to sha256:<64 lowercase hex> object verified against actual bytes",
    "path_root": "total project root containing .lccoding",
    "path_boundary": "canonical NFC Windows-casefold-unique safe relative regular-file path; no hidden metadata component, .lccoding, .git, protected basename, ADS, drive, UNC, dot segment, control, bidi, reserved component, trailing dot/space, escape, symlink, physical-file alias or st_nlink greater than one",
    "duplicate_keys": "REJECT"
  },
  "verification_receipt_contract": "Receipt ID | Candidate ID / sha256:<64 lowercase hex> | package path | package sha256:<64 lowercase hex>; exact one-to-one package coverage"
}
